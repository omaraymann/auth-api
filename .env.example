# Copy this file to .env and fill in your own values:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# The real .env is git-ignored and must never be committed.
# Supabase keys are scraped from public repos within minutes.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project Settings -> API -> anon / public key.
# The anon key ONLY. Never the service_role key: it bypasses all security.
SUPABASE_KEY=CHANGEME

# Port uvicorn listens on.
PORT=8000
